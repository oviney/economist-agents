{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/run_hook.sh\" post_edit_sensor",
            "timeout": 90,
            "statusMessage": "Running harness sensors"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/run_hook.sh\" guard_constraints",
            "timeout": 20,
            "statusMessage": "Checking operating constraints"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/run_hook.sh\" guard_constraints",
            "timeout": 20,
            "statusMessage": "Checking operating constraints"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/run_hook.sh\" session_gate",
            "timeout": 120,
            "statusMessage": "Checking the tree before finishing"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/run_hook.sh\" session_context",
            "timeout": 30,
            "statusMessage": "Loading harness context"
          }
        ]
      }
    ]
  }
}
