# Agent state — ignore runtime data but commit slash commands, agent personas,
# and the harness hook wiring (B-030: hooks are team policy, not personal config —
# .claude/settings.local.json stays ignored)
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json
.gemini/

# Harness sensor history (B-030) — per-session snapshots, runtime data
logs/sensor_history.jsonl

# Stop-gate one-block-per-session sentinels (B-030) — pure runtime state.
# Surfaced as untracked the first time the gate fired in a working tree.
logs/.session_gate/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
.venv-*/

# Agent outputs
content_queue.json
board_decision.json
board_report.md
test_outputs/
model_comparison_results.json
output/

# Runtime telemetry / eval logs (appended-to by tests + pipeline)
logs/article_evals.json
logs/agent_sdk_costs.jsonl

# Secrets
.env
*.key
*_API_KEY*
*.json.bak
*-sa.json

# Google credentials
.google/

# Local data (SQLite, performance metrics)
data/*
# Track orchestrator audit-trail (starts as empty [])
!data/orchestrator_state.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local databases (cached by GitHub Actions)
.chromadb/

# Runtime logs (written by ROI tracker and tests — should not be tracked)
logs/execution_roi.json
logs/quality_dashboard.json
.coverage

# Playwright MCP artifacts
.playwright-mcp/

# MkDocs build output
site/

# Screenshot artifacts
ga4-*.png
search-console-*.png
analytics-tab.png


# Temporary docs review screenshots
docs-site-*.png
github-pages-*.png

home.png
home-*.png

# Transient clone created by scripts/deploy_to_blog.py (and its tests)
temp_blog_repo/

# B-038: real Claude research artifacts are LOCAL fixtures only. This repo is public
# and the artifacts are the owner's own research conversations, so they are never
# committed. tests/test_html_to_brief.py picks up whatever is here and skips cleanly
# when there is nothing. The README explaining the drop point IS tracked.
docs/research/samples/*.html

# ...and the brief converted from one. Same content, same reason. Other briefs in
# docs/research/ are committed normally; only ones derived from a local-only artifact
# are ignored, one line each.
docs/research/sre-quality-governance.md

# The Mermaid VS Code extension writes this unprompted (PR #474, rejected). Nothing in
# the repo asked for Mermaid tooling, and the extension also appends to
# .github/copilot-instructions.md — one of the six governed docs B-028 Task 2 corrected
# after the unreviewed-publish RCA. Ignoring the file stops it being re-offered.
#
# Deliberately NOT the whole .github/instructions/ directory: scripts.instructions.md is
# tracked there and is referenced by docs/RESEARCH_AGENT_EXTRACTION.md.
.github/instructions/mermaid.instructions.md
